# LandGuard AI Evaluation & Research — Git Ignore Specification

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
.env.local
*.pem
*.key

# Virtual Environments
.venv
env/
venv/
ENV/

# Operational database journals and backups (Do NOT commit WAL files or temporary backups)
data/backups/
data/backup_*.db
*.db-shm
*.db-wal

# Large raw datasets and local image uploads (Preserve manifests, fixtures, and canonical operational db)
data/full/
data/pilot/
data/raw/
data/images/
data/cache/
data/uploads/
*.parquet
*.sqlite3

# Model binaries (Preserve frozen production XGBoost model)
models/*.bin
models/*.onnx
!models/README.md
!models/xgboost_risk_model.joblib
!models/model_metadata.json

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & temp files
*.log
=

# Scratch, Debug & Personal Artifacts
ashik/
debug_landing.html
scratch_user_prompt.txt
extract_prompt.py
test_bn_output.pdf
test_tile.jpg

# Internal Sprint Audit & Intermediate Reports (Preserved in External Backup)
*_extracted.txt
DEMO_READINESS.md
LANDGUARD_*_AUDIT.md
LANDGUARD_*_REPORT.md
!LANDGUARD_REPOSITORY_CLEANUP_REPORT.md

