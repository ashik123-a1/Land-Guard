# ==============================================================================
# LandGuard AI — Environment Configuration Specification (.env.example)
# ==============================================================================
# Copy this file to .env for local development or for GitHub Codespaces runtime.
# Active judging deployment: GitHub Codespaces (Port 8000 TLS forwarded).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development, production
ENVIRONMENT=development

# ASGI Server Binding (assigned by host or defaults to 8000)
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. PRIMARY OPERATIONAL DATABASE & FILE STORAGE (LOCAL / CODESPACES)
# ------------------------------------------------------------------------------
# SQLite is ALWAYS the active primary database engine for LandGuard.
DATABASE_BACKEND=SQLITE

# Path to operational SQLite database file.
# Local / Codespaces default: data/landguard_operational.db
LANDGUARD_DB_PATH=data/landguard_operational.db

# Path to writable uploads directory for deed document storage.
# Local / Codespaces default: data/uploads
LANDGUARD_UPLOADS_PATH=data/uploads

# ------------------------------------------------------------------------------
# 3. PUBLIC DOMAIN & QR CODE VERIFICATION LINKS
# ------------------------------------------------------------------------------
# Canonical public base URL used by QR code generator for court-ready dossiers.
# For Local Development: http://localhost:8000
# For GitHub Codespaces: https://expert-engine-gx6rj5vp5xprcwr44-8000.app.github.dev
LANDGUARD_BASE_URL=https://expert-engine-gx6rj5vp5xprcwr44-8000.app.github.dev
PUBLIC_BASE_URL=https://expert-engine-gx6rj5vp5xprcwr44-8000.app.github.dev

# Allowed CORS origins (comma-separated list).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://expert-engine-gx6rj5vp5xprcwr44-8000.app.github.dev

# ------------------------------------------------------------------------------
# 4. DEMO & EVALUATION SETTINGS
# ------------------------------------------------------------------------------
# Set to "true" to allow one-click demonstration role entry for judges/evaluators.
# Set to "false" in strict production environments requiring credential-only login.
ALLOW_DEMO_LOGIN_IN_PROD=true

# ------------------------------------------------------------------------------
# 5. STANDBY NEON SERVERLESS POSTGRESQL (OPTIONAL STANDBY)
# ------------------------------------------------------------------------------
# Neon PostgreSQL configuration is kept on standby and ready for future use.
# It is NOT used for normal application reads or writes while DATABASE_BACKEND=SQLITE.
# To explicitly activate Neon PostgreSQL in the future:
#   1. Set DATABASE_BACKEND=POSTGRESQL
#   2. Provide your valid Neon connection string below
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-demo-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 6. LEGACY / STANDBY DEPLOYMENT REFERENCE (RENDER / VERCEL - UNUSED IN JUDGING)
# ------------------------------------------------------------------------------
# Note: Render and Vercel are legacy standby configurations, unused in current judging.
# If deploying to Render with attached persistent disk in the future, set:
#   LANDGUARD_DB_PATH=/var/data/landguard_operational.db
#   LANDGUARD_UPLOADS_PATH=/var/data/uploads
