# ==============================================================================
# LandGuard Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY OPERATIONAL DATABASE (SQLITE)
# ------------------------------------------------------------------------------
# SQLite is ALWAYS the active and primary database for LandGuard.
# All application runtime features (authentication, sessions, complaints,
# case management, verification records, audit events, and dashboard analytics)
# execute through SQLite at data/landguard_operational.db.
DATABASE_BACKEND=SQLITE

# ------------------------------------------------------------------------------
# 2. STANDBY NEON SERVERLESS POSTGRESQL (FUTURE USE)
# ------------------------------------------------------------------------------
# Neon PostgreSQL configuration is kept on standby and ready for future use.
# It is NOT used for normal application reads or writes while DATABASE_BACKEND=SQLITE.
#
# To explicitly activate Neon PostgreSQL in the future:
#   1. Set DATABASE_BACKEND=POSTGRESQL
#   2. Provide your valid Neon connection string below
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-falling-hat-b4bi5i99-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
