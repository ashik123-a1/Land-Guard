{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FictionalParcel",
  "type": "object",
  "required": [
    "parcel_id",
    "district",
    "upazila",
    "mouza",
    "jl_number",
    "dag_plot_number",
    "total_area_decimal",
    "land_classification",
    "is_synthetic"
  ],
  "properties": {
    "parcel_id": {
      "type": "string",
      "pattern": "^PAR-[0-9A-F]{8}$"
    },
    "district": {
      "type": "string"
    },
    "upazila": {
      "type": "string"
    },
    "mouza": {
      "type": "string"
    },
    "jl_number": {
      "type": "integer",
      "minimum": 1
    },
    "dag_plot_number": {
      "type": "integer",
      "minimum": 1
    },
    "total_area_decimal": {
      "type": "number",
      "minimum": 0.01
    },
    "land_classification": {
      "type": "string",
      "enum": ["Viti", "Nal", "Bari", "Pukur", "Doba", "Chala", "Dokan", "Bagan"]
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "north": { "type": "string" },
        "south": { "type": "string" },
        "east": { "type": "string" },
        "west": { "type": "string" }
      }
    },
    "coordinates_relative": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "is_synthetic": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
