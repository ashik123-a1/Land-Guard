{
  "name": "LandGuard AI Verification Portal",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {},
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y tesseract-ocr tesseract-ocr-ben tesseract-ocr-eng libgl1 libglib2.0-0 && pip install --upgrade pip && pip install -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "LandGuard AI Web Portal",
      "onAutoForward": "openPreview",
      "visibility": "public",
      "elevateIfNeeded": false
    }
  },
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  },
  "postStartCommand": "bash -c 'nohup bash start_codespace.sh > /tmp/landguard_server.log 2>&1 &'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
